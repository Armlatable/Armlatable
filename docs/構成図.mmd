graph LR
    %% ノード定義
    PC[PC]

    %% Dynamixel系統 (直列)
    U2D2(U2D2)
    subgraph DX_Group [ ]
        direction TB
        DX1["Dynamixel"]
        DX2["Dynamixel"]
        DX1 --- DX2
    end
    style DX_Group fill:none,stroke:none

    %% DCモータ系統 (並列)
    UNO["Arduino UNO R4 WiFi"]
    MD[Motor Driver]
    DM1["Diaphragm Pump"]
    DM2["Diaphragm Pump"]

    %% 接続: 左から右へ
    PC --- U2D2
    U2D2 --- DX1
    PC --- UNO
    UNO --- MD
    MD --- DM1
    MD --- DM2

    %% スタイリング（見やすさのため色分けのみ継続）
    style PC fill:#e3f2fd,stroke:#1565c0
    style U2D2 fill:#fff8e1,stroke:#ff8f00
    style DX1 fill:#ffe0b2,stroke:#e65100
    style DX2 fill:#ffe0b2,stroke:#e65100
    style UNO fill:#e0f7fa,stroke:#006064
    style MD fill:#fce4ec,stroke:#ad1457
    style DM1 fill:#e8f5e9,stroke:#2e7d32
    style DM2 fill:#e8f5e9,stroke:#2e7d32